<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../Assets/calendar-mint.ico</ApplicationIcon>
    <AssemblyName>CodexHebdo-Setup</AssemblyName>
    <Version>1.2.1</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../dist/setup-payload.zip" LogicalName="payload.zip" />
    <EmbeddedResource Include="../Assets/calendar-mint.ico" LogicalName="logo.ico" />
    <EmbeddedResource Include="../Assets/calendar-mint.png" LogicalName="logo.png" />
  </ItemGroup>
</Project>
