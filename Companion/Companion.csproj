<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodexHebdo</AssemblyName>
    <Version>1.2.3</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../scripts/Prepare-Symbols.ps1" Link="Prepare-Symbols.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="../Assets/calendar-mint.png" LogicalName="CodexHebdo.calendar.png" />
    <EmbeddedResource Include="../Assets/lolo.svg" LogicalName="CodexHebdo.logo.svg" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>
</Project>
